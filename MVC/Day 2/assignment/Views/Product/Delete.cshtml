@model Product
<h1 class="text-danger">Delete Product</h1>

<br></br>
<hr></hr>
<br></br>

<h4>Are you sure you want to delete this product?</h4>

<br></br>

<h3><strong>Id:</strong> @Model.Id</h3>
<h3><strong>Title:</strong> @Model.Title</h3>
<h3><strong>Description:</strong> @Model.Description</h3>
<h3><strong>Price:</strong> @Model.Price</h3>
<h3><strong>Count:</strong> @Model.Count</h3>

<br></br>

<form action="~/Product/ActualDelete">
    <input type="hidden" name="id" value="@Model.Id">
    <input type="submit" value="Yes" class="btn btn-danger">
    <a class="btn btn-secondary" href="~/Product/Index">No</a>
</form>
