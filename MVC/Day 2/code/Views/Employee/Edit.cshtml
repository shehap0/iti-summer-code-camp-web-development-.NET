@model Employee
<h1 class="text-success">Edit Employee: @Model.Name</h1>

<br></br>
<hr></hr>
<br></br>

<form action="~/Employee/ActualEdit">
    <div class="form-group">
        <label for="Id">Id</label>
        <input type="number" class="form-control" id="Id" name="Id" value="@Model.Id">
    </div>
    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name">
    </div>
    <div class="form-group">
        <label for="Age">Age</label>
        <input type="number" class="form-control" id="Age" name="Age" value="@Model.Age">
    </div>
    <div class="form-group">
        <label for="Salary">Salary</label>
        <input type="number" class="form-control" id="Salary" name="Salary" value="@Model.Salary">
    </div>

    <br></br>

    <div>
        <input type="submit" value="Save" class="btn btn-success">
        <a class="btn btn-outline-danger" href="~/Employee/GetAll">Cancel</a>
    </div>
</form>