@model List<ProductReadVM>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-success fw-bold mb-0">Our Products</h2>
    <a asp-action="Create" asp-controller="Product" class="btn btn-success">+ Add Product</a>
</div>

<hr />

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="position-relative">
                    @if (!string.IsNullOrEmpty(product.ImageURL))
                    {
                        <img src="@product.ImageURL" class="card-img-top" alt="@product.Title" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }
                    <span class="badge bg-success position-absolute top-0 end-0 m-2">@product.Category</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@product.Title</h5>
                    <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="fs-5 fw-bold text-success">$@product.Price</span>
                        <small class="text-muted">Stock: @product.Count</small>
                    </div>
                    <small class="text-muted mb-3">Exp: @product.ExpiryDate.ToString("MMM dd, yyyy")</small>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm flex-fill">View</a>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm flex-fill">Edit</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm">Del</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
