@model ProductReadVM

<div class="card mx-auto" style="max-width: 540px;">
    <div class="row g-0">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.ImageURL))
            {
                <img src="@Model.ImageURL" class="img-fluid rounded-start h-100" alt="@Model.Title" style="object-fit: cover;" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center h-100 rounded-start">
                    <span class="text-muted">No Image</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <div class="card-body">
                <h5 class="card-title fw-bold">@Model.Title</h5>
                <partial name="_ProductDetailsPartial" model="Model"></partial>
                <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary mt-3">Back to Products</a>
            </div>
        </div>
    </div>
</div>
