@model ProductEditVM

<div class="d-flex justify-content-center">
    <h1 class="text-success">Edit Product</h1>
</div>

<br />
<hr />
<br />

<form action="~/Product/Edit" method="post" enctype="multipart/form-data">

    <div class="mb-3 form-group">
        <label for="Id" class="form-label">Id</label>
        <input type="number" class="form-control" id="Id" name="Id" required value="@Model.Id" readonly />
    </div>

    <div class="mb-3 form-group">
        <label for="Title" class="form-label">Title</label>
        <input type="text" class="form-control" id="Title" name="Title" required value="@Model.Title" />
    </div>

    <div class="mb-3 form-group">
        <label for="Description" class="form-label">Description</label>
        <input type="text" class="form-control" id="Description" name="Description" value="@Model.Description" />
    </div>

    <div class="mb-3 form-group">
        <label for="Price" class="form-label">Price</label>
        <input type="number" class="form-control" id="Price" name="Price" required step="0.01" value="@Model.Price" />
    </div>

    <div class="mb-3 form-group">
        <label for="Count" class="form-label">Count</label>
        <input type="number" class="form-control" id="Count" name="Count" required value="@Model.Count" />
    </div>

    <div class="mb-3 form-group">
        <label for="ExpiryDate" class="form-label">Expiry Date</label>
        <input type="date" class="form-control" id="ExpiryDate" name="ExpiryDate" required value="@Model.ExpiryDate.ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3 form-group">
        <label for="Image" class="form-label">Product Image</label>
        @if (!string.IsNullOrEmpty(Model.ImageURL))
        {
            <div>
                <img src="@Model.ImageURL" alt="@Model.Title" width="100" height="100" />
            </div>
        }
        <input type="file" class="form-control" id="Image" name="Image" />
    </div>

    <div class="mb-3 form-group">
        <label for="CategoryId" class="form-label">Category</label>
        <select class="form-select" id="CategoryId" name="CategoryId" required>
            <option value="@Model.CategoryId">@Model.CategoryName</option>
            @foreach (var category in Model.Categories!)
            {
                <option value="@category.Value">@category.Text</option>
            }
        </select>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-success" value="Save" />
        <a href="~/Product/Index" class="btn btn-secondary">Cancel</a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
