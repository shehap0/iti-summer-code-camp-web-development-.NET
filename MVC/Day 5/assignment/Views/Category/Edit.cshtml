@model CategoryEditVM

<div class="d-flex justify-content-center">
    <h1 class="text-success">Edit Category</h1>
</div>

<br />
<hr />
<br />

@using (Html.BeginForm("Edit", "Category", FormMethod.Post))
{
    @Html.HiddenFor(c => c.Id)

    <div class="mb-3 form-group">
        @Html.LabelFor(c => c.Id)
        @Html.EditorFor(c => c.Id, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
    </div>

    <div class="mb-3 form-group">
        @Html.LabelFor(c => c.Name)
        @Html.TextBoxFor(c => c.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(c => c.Name, "", new { @class = "text-danger" })
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-success" value="Save" />
        @Html.ActionLink("Cancel", "Index", "Category", null, new { @class = "btn btn-secondary" })
    </div>
}
