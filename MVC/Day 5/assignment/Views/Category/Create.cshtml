@model CategoryCreateVM

<div class="d-flex justify-content-center">
    <h1 class="text-success">Create Category</h1>
</div>

<br />
<hr />
<br />

@using (Html.BeginForm("Create", "Category", FormMethod.Post))
{
    <div class="mb-3 form-group">
        @Html.LabelFor(c => c.Name)
        @Html.TextBoxFor(c => c.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(c => c.Name, "", new { @class = "text-danger" })
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-success" value="Create Category" />
        @Html.ActionLink("Cancel", "Index", "Category", null, new { @class = "btn btn-secondary" })
    </div>
}
