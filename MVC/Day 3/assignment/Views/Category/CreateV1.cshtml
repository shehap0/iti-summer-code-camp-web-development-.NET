<h1 class="text-success">Create New Category</h1>

<br></br>
<hr></hr>
<br></br>

<form action="~/Category/CreateV1" method="post">
    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" class="form-control" id="Name" name="Name">
    </div>

    <br></br>

    <div>
        <input type="submit" value="Create" class="btn btn-success">
        <a class="btn btn-outline-danger" href="~/Category/IndexV1">Cancel</a>
    </div>
</form>
