@model CategoryEditVM
<h1 class="text-success">Edit Category</h1>

<br></br>
<hr></hr>
<br></br>

<form action="~/Category/EditV2" method="post">
    <div class="form-group">
        <label for="Id">Id</label>
        <input type="number" class="form-control" id="Id" name="Id" value="@Model.Id" readonly>
    </div>
    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name">
    </div>

    <br></br>

    <div>
        <input type="submit" value="Save" class="btn btn-success">
        <a class="btn btn-outline-danger" href="~/Category/IndexV2">Cancel</a>
    </div>
</form>
