@model IEnumerable<ProductReadVM>

<h2 class="text-center text-success">All Products</h2>

<a href="~/Product/CreateV2" class="btn btn-success">Create a New Product</a>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Title</th>
            <th scope="col">Description</th>
            <th scope="col">Price</th>
            <th scope="col">Count</th>
            <th scope="col">Category</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <th scope="row">@product.Id</th>
                <td>@product.Title</td>
                <td>@product.Description</td>
                <td>@product.Price</td>
                <td>@product.Count</td>
                <td>@product.CategoryName</td>
                <td>
                    <a href="~/Product/DetailsV2/@product.Id" class="btn btn-primary">Details</a>
                    <a href="~/Product/EditV2/@product.Id" class="btn btn-secondary">Edit</a>
                    <a href="~/Product/Delete/@product.Id" class="btn btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
