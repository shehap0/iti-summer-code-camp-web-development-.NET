@model EmployeeReadVM
<h2 class="text-success text-center">Employee Details</h2>

<div class="card" style="width: 18rem;">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Model.Id</h6>
        <p class="card-text">@Model.Age - @Model.Salary</p>
        <h6 class="card-subtitle mb-2 text-muted">@Model.DepartmentName</h6>
    </div>
</div>