<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Title</th>
			<th>Description</th>
			<th>Price</th>
			<th>Count</th>
		</tr>
	</thead>
	<tbody>
		@{
			<tr>
				<td>@Model.Id</td>
				<td>@Model.Title</td>
				<td>@Model.Description</td>
				<td>@Model.Price</td>
				<td>@Model.Count</td>
			</tr>
		}
	</tbody>
</table>
