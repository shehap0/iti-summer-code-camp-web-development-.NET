@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Title;
}

<nav class="container breadcrumbs" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span aria-hidden="true">/</span>
    <a asp-controller="Home" asp-action="Products">Shop</a>
    <span aria-hidden="true">/</span>
    <span>@Model.Product.Title</span>
</nav>

<section class="section">
    <div class="container">
        <div class="detail-grid">
            <div class="detail-media reveal">
                @if (!string.IsNullOrEmpty(Model.Product.ImagePath))
                {
                    <img src="@Model.Product.ImagePath" asp-append-version="true" alt="@Model.Product.Title" />
                }
                else
                {
                    <div class="detail-media-placeholder">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    </div>
                }
            </div>

            <div class="detail-info">
                <span class="product-badge product-badge-category">@Model.Product.CategoryName</span>
                <h1 class="detail-title">@Model.Product.Title</h1>
                <p class="detail-desc">@Model.Product.Description</p>

                <div class="detail-price">@Model.Product.Price.ToString("C")</div>

                <div class="detail-facts">
                    <div class="detail-fact">
                        <span class="fact-label">Availability</span>
                        @if (Model.Product.IsExpired)
                        {
                            <span class="fact-value fact-expired">Expired</span>
                        }
                        else if (Model.Product.Count > 0)
                        {
                            <span class="fact-value">In stock — @Model.Product.Count available</span>
                        }
                        else
                        {
                            <span class="fact-value fact-out">Out of stock</span>
                        }
                    </div>
                    <div class="detail-fact">
                        <span class="fact-label">Expiry date</span>
                        <span class="fact-value">@Model.Product.ExpiryDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="detail-actions">
                    <button class="btn btn-primary btn-lg" type="button" onclick="toast('Added to cart (demo)!')">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        Add to cart
                    </button>
                    <a class="btn btn-ghost btn-lg" asp-controller="Home" asp-action="Products">Keep shopping</a>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.RelatedProducts.Any())
{
    <section class="section section-alt">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="section-eyebrow">You may also like</span>
                    <h2 class="section-title">Related products</h2>
                </div>
            </div>
            <div class="product-grid">
                @foreach (var product in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

<div class="toast" id="toast" role="status" aria-live="polite"></div>
