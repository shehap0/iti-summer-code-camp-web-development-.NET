@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="portal-toolbar">
    <p class="muted">@Model.Count @(Model.Count == 1 ? "category" : "categories") total</p>
    <a class="btn btn-primary" asp-controller="Category" asp-action="Create">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Category
    </a>
</div>

@if (Model.Any())
{
    <div class="category-admin-grid">
        @foreach (var category in Model)
        {
            <div class="category-admin-card reveal">
                <div class="category-admin-top">
                    <span class="category-admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                    </span>
                    <a class="btn btn-ghost btn-icon" asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" title="Edit">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z"/></svg>
                    </a>
                    <a class="btn btn-danger-ghost btn-icon" asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" title="Delete">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </a>
                </div>
                <h3 class="category-admin-name">@category.Name</h3>
                <p class="category-admin-count">@category.ProductCount @(category.ProductCount == 1 ? "product" : "products") in this category</p>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon">&#128193;</div>
        <h3>No categories yet</h3>
        <p>Create your first category to start organizing products.</p>
        <a class="btn btn-primary" asp-controller="Category" asp-action="Create">Add Category</a>
    </div>
}
