@model CategoryFormViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="portal-toolbar">
    <a class="btn btn-ghost btn-sm" asp-controller="Category" asp-action="Index">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to categories
    </a>
</div>

<form class="form-card form-card-narrow reveal" method="post" asp-controller="Category" asp-action="Create">
    <h2 class="form-title">New category</h2>
    <p class="muted">Add a category to group related products.</p>
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Electronics" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary btn-lg" type="submit">Save Category</button>
        <a class="btn btn-ghost btn-lg" asp-controller="Category" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
