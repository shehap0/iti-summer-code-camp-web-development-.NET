<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shoply</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <header class="site-header">
        <nav class="container nav-bar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                </span>
                <span class="brand-name">Shop<b>ly</b></span>
            </a>

            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Home" asp-action="Products">Shop</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="categories">Categories</a></li>
            </ul>

            <div class="nav-actions">
                <partial name="_ThemeToggle" />
                <a class="btn btn-ghost btn-sm" asp-controller="Product" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                    <span>Admin Portal</span>
                </a>
            </div>
        </nav>
    </header>

    <main class="site-main">
        <partial name="_FlashMessage" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="brand footer-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                    </span>
                    <span class="brand-name">Shop<b>ly</b></span>
                </a>
                <p class="footer-tagline">A modern storefront demo built with ASP.NET Core MVC &amp; EF Core.</p>
            </div>
            <div>
                <h4>Explore</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Home" asp-action="Products">All Products</a></li>
                    <li><a asp-controller="Product" asp-action="Index">Admin Portal</a></li>
                </ul>
            </div>
            <div>
                <h4>About</h4>
                <ul>
                    <li><a href="#">Story</a></li>
                    <li><a href="#">Careers</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </div>
            <div>
                <h4>Stay in the loop</h4>
                <p class="footer-note">Fresh arrivals, straight to your inbox.</p>
                <form class="newsletter" onsubmit="return false;">
                    <input type="email" placeholder="you@example.com" aria-label="Email address" />
                    <button class="btn btn-primary btn-sm" type="submit">Join</button>
                </form>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>&copy; @DateTime.Now.Year Shoply — All rights reserved.</span>
            <span>Made with <span class="heart">&#10084;</span> &amp; .NET</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
