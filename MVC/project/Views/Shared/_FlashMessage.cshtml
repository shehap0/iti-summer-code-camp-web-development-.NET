@if (TempData["Success"] != null)
{
    <div class="flash flash-success" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@TempData["Success"]</span>
        <button class="flash-close" type="button" aria-label="Dismiss">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="flash flash-error" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@TempData["Error"]</span>
        <button class="flash-close" type="button" aria-label="Dismiss">&times;</button>
    </div>
}
