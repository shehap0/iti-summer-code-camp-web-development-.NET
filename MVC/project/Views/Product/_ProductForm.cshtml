@model ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

<div class="form-grid">
    <div class="form-group form-group-full">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Aurora Wireless Headphones" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group form-group-full">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="4" placeholder="A short, catchy description..."></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <div class="input-prefix">
            <span>$</span>
            <input asp-for="Price" class="form-control" placeholder="0.00" />
        </div>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Count"></label>
        <input asp-for="Count" class="form-control" placeholder="e.g. 25" />
        <span asp-validation-for="Count" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ExpiryDate"></label>
        <input asp-for="ExpiryDate" class="form-control" type="date" />
        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control">
            <option value="">-- Select a category --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group form-group-full">
        <label asp-for="Image"></label>
        <div class="file-upload" data-file-upload>
            <input asp-for="Image" type="file" accept="image/*" />
            <div class="file-upload-ui">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span class="file-upload-text">Click to upload or drag &amp; drop</span>
                <small class="muted">JPG, PNG, WEBP or GIF — max 5 MB</small>
            </div>
        </div>
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ExistingImagePath))
{
    <div class="current-image">
        <span class="fact-label">Current image</span>
        <img src="@Model.ExistingImagePath" asp-append-version="true" alt="Current product image" />
    </div>
}

<div class="form-actions">
    <button class="btn btn-primary btn-lg" type="submit">Save Product</button>
    <a class="btn btn-ghost btn-lg" asp-controller="Product" asp-action="Index">Cancel</a>
</div>
