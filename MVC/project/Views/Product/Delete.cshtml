@model ProductViewModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="delete-card reveal">
    <div class="delete-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
    </div>
    <h2 class="form-title">Delete this product?</h2>
    <p class="muted">This action is permanent and cannot be undone. The product image will also be removed.</p>

    <div class="delete-preview">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img class="delete-thumb" src="@Model.ImagePath" asp-append-version="true" alt="@Model.Title" />
        }
        <div class="delete-info">
            <strong>@Model.Title</strong>
            <span class="muted">@Model.CategoryName</span>
            <span class="muted">@Model.Price.ToString("C") &middot; @Model.Count in stock</span>
        </div>
    </div>

    <form method="post" asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id">
        <div class="form-actions">
            <button class="btn btn-danger btn-lg" type="submit">Yes, delete it</button>
            <a class="btn btn-ghost btn-lg" asp-controller="Product" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
