
@model List<Department>

<div class="d-flex justify-content-center">
    <h2 class="text-success">Departments Portal</h2>
</div>

<br />
<hr />
<br />

<table class="table text-center">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
				<th scope="row">@dept.Id</th>
                <th scope="row">@dept.Name</th>
                <th scope="row">
                    <a href="~/Department/Details/@dept.Id" class="btn btn-primary">Details</a>
                    <a href="~/Department/Edit/@dept.Id" class="btn btn-outline-secondary">Edit</a>
                    <a href="~/Department/Delete/@dept.Id" class="btn btn-outline-danger">Delete</a>
                </th>
            </tr>
        }
    </tbody>
    <tfoot>
        <a href="~/Department/Create" class="btn btn-success">Create New Department</a>
    </tfoot>
</table>