@model ProductCreateVM

<div class="d-flex justify-content-center">
    <h1 class="text-success">Create Product</h1>
</div>

<br />
<hr />
<br />

<form asp-action="Create" asp-controller="Product" method="post">
    <div class="mb-3 form-group">
        <label asp-for="Title"></label>
        <input type="text" asp-for="Title" class="form-control">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3 form-group">
        <label asp-for="Description"></label>
        <input type="text" asp-for="Description" class="form-control">
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3 form-group">
        <label asp-for="Price"></label>
        <input type="number" asp-for="Price" class="form-control" step="0.01">
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3 form-group">
        <label asp-for="Count"></label>
        <input type="number" asp-for="Count" class="form-control">
        <span asp-validation-for="Count" class="text-danger"></span>
    </div>

    <div class="mb-3 form-group">
        <label asp-for="ExpiryDate"></label>
        <input type="date" asp-for="ExpiryDate" class="form-control">
        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
    </div>

    <div class="mb-3 form-group">
        <label asp-for="CategoryId"></label>
        <select class="form-select" asp-for="CategoryId" asp-items="Model.Categories!">
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-success" value="Create Product" />
        <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Cancel</a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
