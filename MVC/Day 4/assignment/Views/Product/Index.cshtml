@model List<ProductReadVM>

<div class="d-flex justify-content-center">
    <h2 class="text-success">Products Portal</h2>
</div>

<br />
<hr />
<br />

<table class="table text-center">
    <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">Price</th>
            <th scope="col">Count</th>
            <th scope="col">Expiry Date</th>
            <th scope="col">Category</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <th scope="row">@product.Title</th>
                <th scope="row">@product.Price</th>
                <th scope="row">@product.Count</th>
                <th scope="row">@product.ExpiryDate</th>
                <th scope="row">@product.Category</th>
                <th scope="row">
                    <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-primary">Details</a>
                    <a asp-action="Edit" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-outline-danger">Delete</a>
                </th>
            </tr>
        }
    </tbody>
    <tfoot>
        <a asp-action="Create" asp-controller="Product" class="btn btn-success">Create New Product</a>
    </tfoot>
</table>
