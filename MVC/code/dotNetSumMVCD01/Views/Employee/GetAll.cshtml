@* Model = emps *@

@* @{
	int x = 10;
}

<h1>@x</h1> *@

<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Salary</th>
			<th>Age</th>
		</tr>
	</thead>
	<tbody>
		@{
			foreach (var emp in Model)
			{
				<tr>
					<td>@emp.Id</td>
					<td>@emp.Name</td>
					<td>@emp.Salary</td>
					<td>@emp.Age</td>
				</tr>
			}
		}
	</tbody>
</table>